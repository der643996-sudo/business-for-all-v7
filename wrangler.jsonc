{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-for-all-production",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "AUTO_RESOLVED_BY_START_SCRIPT",
      "database_id": "5bcf36c6-e1fc-47d4-8431-6d1fc1c8aa5a",
      "migrations_dir": "migrations"
    }
  ]
}
