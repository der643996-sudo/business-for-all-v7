{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-for-all-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_NEW_STAGING_DB",
      "database_id": "REPLACE_WITH_NEW_STAGING_D1_ID",
      "migrations_dir": "migrations",
      "remote": true
    }
  ]
}
